{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/main/src/content/docs/_schema/config.schema.json",
  "productName": "ResearchReader",
  "version": "0.1.0",
  "identifier": "com.researchreader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ResearchReader",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
